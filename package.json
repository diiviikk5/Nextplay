{
  "name": "nextplay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx && node scripts/build/prerender.mjs",
    "data:igdb": "node --env-file-if-exists=.env scripts/data/fetch-igdb.mjs",
    "data:steam": "node scripts/data/fetch-steam.mjs",
    "data": "npm run data:igdb && npm run data:steam",
    "lint": "eslint .",
    "preview": "vite preview",
    "indexnow": "node scripts/ping_indexnow.js"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
