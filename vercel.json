      "destination": "/releases/2026",
      "permanent": true
    },
    {
      "source": "/genre/rpg",
      "destination": "/genre/role-playing-rpg",
      "permanent": true
    },
    {
      "source": "/genre/platformer",
      "destination": "/genre/platform",
      "permanent": true
    },
    {
      "source": "/genre/sports",
      "destination": "/genre/sport",
      "permanent": true
    },
    {
      "source": "/genre/simulation",
      "destination": "/genre/simulator",
      "permanent": true
    },
    {
      "source": "/genre/card-game",
      "destination": "/genre/card-board-game",
      "permanent": true
    },
    {
      "source": "/game/crimson-desert",
      "destination": "/game/crimson-desert-enhanced--1",
      "permanent": true
    },
    {
      "source": "/games-like/crimson-desert",
      "destination": "/games-like/crimson-desert-enhanced--1",
      "permanent": true
    },
    {
      "source": "/system-requirements/crimson-desert",
      "destination": "/system-requirements/crimson-desert-enhanced--1",
      "permanent": true
    },
    {
      "source": "/game/lost-in-cheese",
      "destination": "/game/lost-in-cheese--1",
      "permanent": true
    },
    {
      "source": "/games-like/lost-in-cheese",
      "destination": "/games-like/lost-in-cheese--1",
      "permanent": true
    },
    {
      "source": "/system-requirements/lost-in-cheese",
      "destination": "/system-requirements/lost-in-cheese--1",
      "permanent": true
    },
    {
      "source": "/game/megastore-simulator",
      "destination": "/game/megastore-simulator--1",
      "permanent": true
    },
    {
      "source": "/games-like/megastore-simulator",
      "destination": "/games-like/megastore-simulator--1",
      "permanent": true
    },
    {
      "source": "/system-requirements/megastore-simulator",
      "destination": "/system-requirements/megastore-simulator--1",
      "permanent": true
    },
    {
      "source": "/game/resident-evil-9-requiem",
      "destination": "/game/resident-evil-requiem",
      "permanent": true
    },
    {
      "source": "/games-like/resident-evil-9-requiem",
      "destination": "/games-like/resident-evil-requiem",
      "permanent": true
    },
    {
      "source": "/system-requirements/resident-evil-9-requiem",
      "destination": "/system-requirements/resident-evil-requiem",
      "permanent": true
    },
    {
      "source": "/game/restory",
      "destination": "/game/restory-chill-electronics-repairs",
      "permanent": true
    },
    {
      "source": "/games-like/restory",
      "destination": "/games-like/restory-chill-electronics-repairs",
      "permanent": true
    },
    {
      "source": "/system-requirements/restory",
      "destination": "/system-requirements/restory-chill-electronics-repairs",
      "permanent": true
    },
    {
      "source": "/game/the-dark-pictures-directive-8020",
      "destination": "/game/directive-8020",
      "permanent": true
    },
    {
      "source": "/games-like/the-dark-pictures-directive-8020",
      "destination": "/games-like/directive-8020",
      "permanent": true
    },
    {
      "source": "/system-requirements/the-dark-pictures-directive-8020",
      "destination": "/system-requirements/directive-8020",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/games-like/:slug",
      "destination": "/game/:slug"
    },
    {
      "source": "/system-requirements/:slug",
      "destination": "/game/:slug"
    },
    {
      "source": "/games/:platform/:genre",
      "destination": "/platform/:platform"
    },
    {
      "source": "/developer/:slug",
      "destination": "/developer"
    },
    {
      "source": "/publisher/:slug",
      "destination": "/publisher"
    },
    {
      "source": "/genre/:slug",
      "destination": "/genre"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
