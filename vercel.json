      "permanent": true
    },
    {
      "source": "/calendar/2026-11",
      "destination": "/releases/2026/november",
      "permanent": true
    },
    {
      "source": "/calendar/2026-12",
      "destination": "/releases/2026/december",
      "permanent": true
    },
    {
      "source": "/calendar/01",
      "destination": "/releases/2026/january",
      "permanent": true
    },
    {
      "source": "/calendar/02",
      "destination": "/releases/2026/february",
      "permanent": true
    },
    {
      "source": "/calendar/03",
      "destination": "/releases/2026/march",
      "permanent": true
    },
    {
      "source": "/calendar/04",
      "destination": "/releases/2026/april",
      "permanent": true
    },
    {
      "source": "/calendar/05",
      "destination": "/releases/2026/may",
      "permanent": true
    },
    {
      "source": "/calendar/06",
      "destination": "/releases/2026/june",
