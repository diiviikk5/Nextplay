{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/trends",
      "destination": "/trending",
      "permanent": true
    },
    {
      "source": "/trends/:path*",
      "destination": "/trending",
      "permanent": true
    },
    {
      "source": "/compare",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/compare/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/battles",
      "destination": "/most-anticipated",
      "permanent": true
    },
    {
      "source": "/bracket",
      "destination": "/tier-list",
      "permanent": true
    },
    {
      "source": "/game-finder",
      "destination": "/upcoming",
      "permanent": true
    },
    {
      "source": "/my-top-5",
      "destination": "/tier-list",
      "permanent": true
    },
    {
      "source": "/embed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/service/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/calendar",
      "destination": "/releases",
      "permanent": true
    },
    {
      "source": "/calendar/2026-01",
      "destination": "/releases/2026/january",
      "permanent": true
    },
    {
