      "permanent": true
    },
    {
      "source": "/calendar/2026-03",
      "destination": "/releases/2026/march",
      "permanent": true
    },
    {
      "source": "/calendar/2026-04",
      "destination": "/releases/2026/april",
      "permanent": true
    },
    {
      "source": "/calendar/2026-05",
      "destination": "/releases/2026/may",
      "permanent": true
    },
    {
      "source": "/calendar/2026-06",
      "destination": "/releases/2026/june",
      "permanent": true
    },
    {
      "source": "/calendar/2026-07",
      "destination": "/releases/2026/july",
      "permanent": true
    },
    {
      "source": "/calendar/2026-08",
